rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Gallery photos. Unchanged from the rules deployed in March 2026.
    match /hubs/{hubId}/photos/{imageId} {
      // Basic rule: User must be logged in
      allow read, write: if request.auth != null;
    }

    // Recipe pictures: hubs/{hubId}/recipes/{recipeId}/{file}.
    // The app uploads a resized JPEG (about 1200px, normally < 500 KB).
    // Signed-in users only; images only; 5 MB cap.
    match /hubs/{hubId}/recipes/{recipeId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
          && request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if request.auth != null;
    }
  }
}
